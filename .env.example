# Static frontend deployment
SURGE_LOGIN=
SURGE_TOKEN=
SURGE_DOMAIN=wandersync-travel-1779355803.surge.sh

# Optional Node API configuration
PORT=8000
WANDERSYNC_DATA_DIR=.data
WANDERSYNC_PUBLIC_API_BASE=
WANDERSYNC_ENABLE_REMOTE_SYNC=true
WANDERSYNC_ALLOWED_ORIGIN=*

# Optional Google Routes API (server-side only)
GOOGLE_ROUTES_API_KEY=

# Optional normalized GTFS/transit provider proxy (server-side only)
WANDERSYNC_GTFS_API_URL=
WANDERSYNC_TRANSIT_PROVIDER=

# Optional normalized flight provider endpoint. It must accept POST JSON with
# fromCityId, toCityId, departureDate, preferDirect and return durationMinutes,
# direct, actualFlightTime, transferTime, waitTime, baggageTime, layoverTime,
# distanceKm, provider and source.
WANDERSYNC_FLIGHT_API_URL=
WANDERSYNC_FLIGHT_PROVIDER=
